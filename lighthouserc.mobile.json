{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/about/",
        "http://localhost:4321/services/",
        "http://localhost:4321/services/fiscal-hosting/",
        "http://localhost:4321/services/technical-resources-guidance/",
        "http://localhost:4321/services/admin-financial-support/",
        "http://localhost:4321/how-to-join/",
        "http://localhost:4321/contact/",
        "http://localhost:4321/ask/",
        "http://localhost:4321/privacy-policy/",
        "http://localhost:4321/term-conditions/"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "npm run preview -- --port 4321",
      "startServerReadyPattern": "localhost:4321",
      "startServerReadyTimeout": 30000,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    }
  }
}
