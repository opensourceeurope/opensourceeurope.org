---
import { getCollection } from 'astro:content';
import Sections from '../../components/Sections.astro';
import Base from '../../layouts/Base.astro';
import { loadPage } from '../../lib/page';
import { serviceJsonLd } from '../../lib/seo';

// One page per entry in src/content/services/. The file name is the slug.
export async function getStaticPaths() {
  return (await getCollection('services')).map((entry) => ({ params: { slug: entry.id } }));
}

const { seo, sections } = await loadPage('services', Astro.params.slug);
const jsonLd = [serviceJsonLd(Astro.site!, new URL(Astro.url.pathname, Astro.site).href, seo)];
---

<Base seo={seo} jsonLd={jsonLd}>
  <Sections sections={sections} />
</Base>
