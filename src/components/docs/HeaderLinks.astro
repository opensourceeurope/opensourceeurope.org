---
// Links from the docs header back to the site, and the apply button.
// Replaces Starlight's social icons. Texts come from src/content/settings/docs.yaml.
import { loadSettings } from '../../lib/site';
import { parseDocsSettings } from '../../lib/docs-settings.mjs';
import docsYaml from '../../content/settings/docs.yaml?raw';

const { apply_url } = await loadSettings();
const docs = parseDocsSettings(docsYaml);
---

<nav class="docs-links" aria-label={docs.header_nav_label}>
  {
    docs.header_links.map((link) => (
      <a class="docs-links__link" href={link.href}>
        {link.label}
      </a>
    ))
  }
  <a class="docs-links__apply" href={apply_url}>{docs.apply_label}</a>
</nav>

<style>
  .docs-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .docs-links__link,
  .docs-links__apply {
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .docs-links__link {
    color: var(--sl-color-white);
  }
  .docs-links__link:hover {
    color: var(--sl-color-accent-high);
  }
  .docs-links__apply {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .docs-links__apply:hover {
    background: var(--sl-color-accent-high);
  }
</style>
