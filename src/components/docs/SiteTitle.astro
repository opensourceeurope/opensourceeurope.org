---
// The OSE logo and the docs title, linking to the docs home.
import { loadSettings } from '../../lib/site';
import { parseDocsSettings } from '../../lib/docs-settings.mjs';
import docsYaml from '../../content/settings/docs.yaml?raw';

const { ui } = await loadSettings();
const docs = parseDocsSettings(docsYaml);
---

<a class="docs-title" href="/docs/">
  <img src={ui.logo.src} alt={ui.logo.alt} width={ui.logo.width} height={ui.logo.height} />
  <span class="docs-title__label">{docs.title}</span>
</a>

<style>
  .docs-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--sl-color-white);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--sl-text-h4);
    white-space: nowrap;
  }
  .docs-title img {
    height: 2.25rem;
    width: auto;
  }
  .docs-title__label {
    padding-inline-start: 0.75rem;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
  }
</style>
