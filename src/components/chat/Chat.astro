---
import { PUBLIC_CHAT_ENDPOINT } from 'astro:env/client';
import type { ChatTexts } from '../../scripts/chat/types';

interface Props {
  texts: ChatTexts;
  variant: 'page' | 'panel';
}
const { texts, variant } = Astro.props;
const uid = `chat-${variant}`;
---

<div
  class={`chat chat--${variant}`}
  data-chat
  data-chat-endpoint={PUBLIC_CHAT_ENDPOINT}
  data-chat-texts={JSON.stringify(texts)}
>
  <p class="chat__no-js">{texts.no_js}</p>
  <div class="chat__app">
    <div class="chat__transcript" data-chat-transcript aria-live="polite">
      <div class="chat__empty" data-chat-empty>
        {variant === 'panel' && <p class="chat__intro">{texts.intro}</p>}
        <p class="chat__suggest-label" id={`${uid}-suggest`}>{texts.suggestions_label}</p>
        <ul class="chat__suggestions" aria-labelledby={`${uid}-suggest`}>
          {
            texts.suggestions.map((s) => (
              <li>
                <button type="button" class="chat__chip" data-chat-suggestion={s}>
                  {s}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="visually-hidden" role="status" data-chat-status></p>
    <form class="chat__form" data-chat-form autocomplete="off">
      <label class="visually-hidden" for={`${uid}-input`}>{texts.input_label}</label>
      <div class="chat__composer">
        <textarea
          id={`${uid}-input`}
          class="chat__input"
          rows="1"
          placeholder={texts.placeholder}
          data-gramm="false"
          data-gramm_editor="false"
          data-enable-grammarly="false"
          data-chat-input></textarea>
        <button type="submit" class="chat__send" aria-label={texts.send_label} data-chat-send>
          <svg class="chat__send-icon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
            <path
              d="M9 15V3M3.5 8.5L9 3l5.5 5.5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"></path>
          </svg>
          <svg class="chat__stop-icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
            <rect x="1" y="1" width="12" height="12" rx="2" fill="currentColor"></rect>
          </svg>
        </button>
      </div>
      <div class="chat__honeypot" aria-hidden="true">
        <label for={`${uid}-website`}>{texts.honeypot_label}</label>
        <input id={`${uid}-website`} name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" data-chat-honeypot />
      </div>
    </form>
    <div class="chat__meta">
      <p class="chat__note chat__local">
        {texts.local_note}{' '}
        <a class="chat__meta-link" href={texts.local_link.href}>{texts.local_link.label}</a>
      </p>
      <p class="chat__sharing" aria-live="polite">
        <span data-chat-sharing-text>{texts.sharing_off}</span>{' '}
        <button type="button" class="chat__meta-link" data-consent-open>{texts.sharing_settings}</button>
      </p>
      <p class="chat__note">
        {`${texts.demo_note} ${texts.memory_note}`}
        {
          variant === 'panel' && (
            <>
              {' '}
              <a class="chat__meta-link" href={texts.how_it_works.href}>
                {texts.how_it_works.label}
              </a>
            </>
          )
        }
      </p>
    </div>
  </div>
</div>
