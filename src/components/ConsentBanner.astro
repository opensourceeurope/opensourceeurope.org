---
interface Props {
  consent: {
    title: string;
    body: string;
    privacy_link: { label: string; href: string };
    accept: string;
    reject: string;
    settings: string;
    save: string;
    close_label: string;
    always_on: string;
    necessary: { name: string; description: string };
    analytics: { name: string; description: string };
  };
}
const { consent } = Astro.props;
---

<!-- First in the body, so it is first in the tab order when shown. Hidden until the script finds no stored choice, so without JavaScript it never covers content. -->
<section class="consent" role="region" aria-labelledby="consent-title" data-consent hidden>
  <div class="consent__head">
    <h2 id="consent-title" class="consent__title">{consent.title}</h2>
    <button type="button" class="consent__close" aria-label={consent.close_label} data-consent-close>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"></path>
      </svg>
    </button>
  </div>

  <div data-consent-main>
    <p class="consent__body">
      {consent.body} <a href={consent.privacy_link.href}>{consent.privacy_link.label}</a>
    </p>
    <div class="consent__actions">
      <button type="button" class="consent__btn" data-consent-accept>{consent.accept}</button>
      <button type="button" class="consent__btn" data-consent-manage>{consent.settings}</button>
      <button type="button" class="consent__btn" data-consent-reject>{consent.reject}</button>
    </div>
  </div>

  <div data-consent-settings hidden>
    <ul class="consent__list">
      <li class="consent__row">
        <div>
          <span class="consent__name" id="consent-necessary">{consent.necessary.name}</span>
          <p class="consent__desc">{consent.necessary.description}</p>
        </div>
        <span class="consent__state">{consent.always_on}</span>
      </li>
      <li class="consent__row">
        <div>
          <label class="consent__name" for="consent-analytics">{consent.analytics.name}</label>
          <p class="consent__desc" id="consent-analytics-desc">{consent.analytics.description}</p>
        </div>
        <input
          type="checkbox"
          role="switch"
          class="consent__switch"
          id="consent-analytics"
          aria-describedby="consent-analytics-desc"
          data-consent-toggle
        />
      </li>
    </ul>
    <button type="button" class="consent__btn" data-consent-save>{consent.save}</button>
  </div>
</section>

<script>
  import { initConsent } from '../scripts/consent';
  initConsent();
</script>

<style>
  .consent {
    position: fixed;
    z-index: 1100;
    inset: auto var(--space-3) var(--space-3) var(--space-3);
    max-height: calc(100vh - var(--space-5));
    overflow-y: auto;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-media);
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 8px 32px rgb(0 0 0 / 40%);
  }
  .consent[hidden],
  [data-consent-main][hidden],
  [data-consent-settings][hidden] {
    display: none;
  }
  @media (min-width: 640px) {
    .consent {
      inset: auto var(--space-5) var(--space-5) auto;
      width: 424px;
    }
  }
  .consent__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .consent__title {
    margin: 0;
    font-size: 20px;
    line-height: 28px;
    font-weight: var(--weight-semibold);
  }
  .consent__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .consent__body {
    margin: 0 0 var(--space-5);
    font-size: var(--text-sm);
    line-height: var(--leading-body-text);
    font-weight: var(--weight-light);
  }
  .consent__body a {
    color: inherit;
    text-decoration: underline;
  }
  .consent__actions {
    display: grid;
    gap: var(--space-3);
  }
  /* Accept, reject and the rest share one style, so no choice is nudged. */
  .consent__btn {
    width: 100%;
    height: var(--button-height);
    padding-inline: var(--space-4);
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      var(--gradient-brand) border-box;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-label);
    line-height: var(--leading-label);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
  }
  .consent__list {
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }
  .consent__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
  }
  .consent__row + .consent__row {
    border-top: 1px solid var(--color-border);
  }
  .consent__name {
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
  }
  .consent__desc {
    margin: var(--space-1) 0 0;
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    font-weight: var(--weight-light);
  }
  .consent__state {
    flex: none;
    font-size: var(--text-xs);
    line-height: 24px;
  }
  .consent__switch {
    flex: none;
    appearance: none;
    position: relative;
    width: 44px;
    height: 24px;
    margin: 0;
    border: 2px solid var(--color-input-border);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
  }
  .consent__switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-text);
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  .consent__switch:checked {
    border-color: var(--color-brand-blue);
    background: var(--color-brand-blue);
  }
  .consent__switch:checked::after {
    transform: translateX(20px);
  }
</style>
