---
import DotIcon from '../DotIcon.astro';
import Eyebrow from '../Eyebrow.astro';
import Heading from '../Heading.astro';
import type { SectionOf } from '../../lib/sections';
import { faqJsonLd } from '../../lib/seo';

interface Props {
  section: SectionOf<'faq'>;
}
const { section } = Astro.props;
---

<!-- The questions and answers as a FAQPage, for search engines and AI answer tools. -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd(section.items))} />

<section id={section.id} class="faq grid-26">
  <div class="faq__head">
    <Eyebrow text={section.eyebrow} />
    <Heading heading={section.heading} />
  </div>
  <div class="faq__items" data-faq>
    {
      section.items.map((item) => (
        <details open>
          <summary>
            <DotIcon kind="arrow" />
            <span>{item.question}</span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
    <!-- Answers start open so they show without JavaScript; with it, they start closed as on the live site,
         and a shared name lets only one stay open at a time (E11). The name is set here, not in the markup,
         because the browser would otherwise close all but the first open answer without JavaScript. -->
    <script is:inline>
      {
        const faq = document.currentScript.parentElement;
        const group = `faq-${[...document.querySelectorAll('[data-faq]')].indexOf(faq)}`;
        for (const item of faq.querySelectorAll('details')) {
          item.open = false;
          item.name = group;
        }
      }
    </script>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-pad-y-lg);
  }
  .faq__head > :global(* + *) {
    margin-top: var(--space-4);
  }
  .faq :global(h2) {
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
  }
  .faq__items {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  /* Two 1 px rings as on live: the outer one at 16 % white, the inner one
     where two 16 % layers overlap. */
  details {
    padding: 1px;
    border: 1px solid var(--color-white-16);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 29%);
  }
  details:hover {
    background: var(--color-surface-hover);
  }
  /* E11: the answer grows to its height, where the browser can animate it. */
  details {
    interpolate-size: allow-keywords;
  }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size var(--duration-base) var(--ease-standard),
      content-visibility var(--duration-base) allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition: none;
    }
  }
  summary {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: var(--space-4);
    font-size: var(--text-h3);
    line-height: var(--leading-h3);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* The live question text is capped, so long questions wrap early. */
  summary span {
    max-width: 280px;
  }
  summary :global(svg) {
    color: var(--color-faq-icon);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  details[open] summary :global(svg) {
    transform: rotate(90deg);
  }
  details p {
    margin: 0;
    padding: 0 var(--space-4) var(--space-4) 56px;
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    font-weight: var(--weight-light);
  }

  @media (min-width: 1024px) {
    .faq {
      padding-top: var(--space-9);
    }
    .faq__head {
      grid-column: 3 / 12;
    }
    .faq__head > :global(.eyebrow) {
      margin-top: 8px;
    }
    .faq__items {
      grid-column: 13 / 25;
      grid-row: 1;
      gap: var(--space-4);
      margin-top: 36px;
    }
    summary {
      padding: var(--space-5) var(--space-6);
    }
    summary span {
      max-width: 380px;
    }
    details p {
      padding: 0 var(--space-6) 36px 72px;
      font-size: var(--text-base);
      line-height: 24px;
    }
  }
</style>
