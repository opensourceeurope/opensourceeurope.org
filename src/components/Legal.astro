---
import Img from './Img.astro';
import type { ImageData } from '../lib/sections';

interface Props {
  title: string;
  lead?: string;
  background: ImageData;
}
const { title, lead, background } = Astro.props;
---

<section class="legal-title grid-26">
  <div class="legal-title__bg">
    <Img image={background} loading="eager" />
  </div>
  <div class="legal-title__text">
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
  </div>
</section>
<section class="legal grid-26">
  <div class="legal__body">
    <slot />
  </div>
</section>

<style>
  .legal-title {
    position: relative;
    isolation: isolate;
    padding-block: 178px 54px;
  }
  .legal-title__bg {
    grid-column: auto;
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .legal-title__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .legal-title__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(-1deg, var(--color-bg) 10%, transparent);
  }
  h1 {
    font-size: var(--text-h2);
    line-height: var(--leading-h2);
    font-weight: var(--weight-medium);
  }
  .legal-title p {
    margin: var(--space-5) 0 0;
    font-size: 18px;
    line-height: 26px;
    font-weight: var(--weight-semibold);
  }

  .legal {
    padding-bottom: var(--section-pad-y);
  }
  .legal__body :global(h2) {
    margin: var(--space-6) 0 var(--space-4);
    font-size: 18px;
    line-height: 30px;
    font-weight: var(--weight-semibold);
  }
  .legal__body :global(h2:first-child) {
    margin-top: 0;
  }
  .legal__body :global(p) {
    margin: var(--space-3) 0 0;
    font-size: 16px;
    line-height: 24px;
    font-weight: var(--weight-light);
  }
  .legal__body :global(h2 + p) {
    margin-top: 0;
  }
  .legal__body :global(a) {
    color: inherit;
    text-decoration: underline;
  }

  @media (min-width: 1024px) {
    .legal-title {
      padding-top: 169px;
    }
    .legal-title__text,
    .legal__body {
      grid-column: 6 / 22;
    }
    .legal-title p {
      font-size: 20px;
      line-height: 30px;
    }
    .legal {
      padding-bottom: var(--space-10);
    }
    .legal__body :global(h2) {
      font-size: 20px;
    }
    .legal__body :global(p) {
      margin-top: var(--space-4);
    }
  }
</style>
