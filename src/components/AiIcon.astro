---
// Sparkle mark next to the links that open the Ask chat. Decorative: the link text names it.
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  aria-hidden="true"
  focusable="false"
  ><path
    d="M6.5 1.5 7.8 5.2a1.5 1.5 0 0 0 .9.9l3.8 1.4-3.8 1.4a1.5 1.5 0 0 0-.9.9L6.5 13.5 5.2 9.8a1.5 1.5 0 0 0-.9-.9L.5 7.5l3.8-1.4a1.5 1.5 0 0 0 .9-.9zM13 .5l.5 1.5 1.5.5-1.5.5-.5 1.5-.5-1.5L11 2.5l1.5-.5z"
    fill="currentColor"></path></svg
>
