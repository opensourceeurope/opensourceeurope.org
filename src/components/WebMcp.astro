---
// Registers two WebMCP tools (https://webmachinelearning.github.io/webmcp/) when the
// browser supports the API: list_pages returns /llms.txt, and ask_ose sends a question
// to the chat function, as the Ask panel does, with analytics off. The texts are in
// `webmcp` in site.yaml.
import { loadSettings } from '../lib/site';

const { webmcp } = await loadSettings();
---

<div hidden data-webmcp={JSON.stringify(webmcp)}></div>

<script>
  import { PUBLIC_CHAT_ENDPOINT } from 'astro:env/client';

  type ToolResult = { content: { type: 'text'; text: string }[]; isError?: boolean };
  type Tool = {
    name: string;
    description: string;
    inputSchema: object;
    execute: (input: Record<string, unknown>) => Promise<ToolResult>;
  };
  type ModelContext = { registerTool: (tool: Tool) => unknown };

  const context = ((document as unknown as { modelContext?: ModelContext }).modelContext ??
    (navigator as unknown as { modelContext?: ModelContext }).modelContext) as ModelContext | undefined;
  const el = document.querySelector<HTMLElement>('[data-webmcp]');

  const text = (value: string, isError = false): ToolResult => ({ content: [{ type: 'text', text: value }], isError });

  if (context?.registerTool && el) {
    const texts = JSON.parse(el.dataset.webmcp ?? '{}') as Record<string, string>;
    const register = (tool: Tool) => {
      try {
        void Promise.resolve(context.registerTool(tool)).catch(() => undefined);
      } catch {
        // A tool with this name is already registered, or the API refused it.
      }
    };
    register({
      name: 'list_pages',
      description: texts.list_pages_description,
      inputSchema: { type: 'object', properties: {} },
      execute: async () => {
        const res = await fetch('/llms.txt');
        return res.ok ? text(await res.text()) : text(`llms.txt answered ${res.status}`, true);
      },
    });
    register({
      name: 'ask_ose',
      description: texts.ask_description,
      inputSchema: {
        type: 'object',
        properties: { question: { type: 'string', description: texts.question_description } },
        required: ['question'],
      },
      execute: async (input) => {
        const question = typeof input.question === 'string' ? input.question.trim() : '';
        if (!question) return text('Give a question.', true);
        const { sendChat } = await import('../scripts/chat/client');
        try {
          const reply = await sendChat(PUBLIC_CHAT_ENDPOINT, [{ role: 'user', content: question }], false);
          const sources = reply.citations.map((c) => `- ${c.title ? `${c.title}: ` : ''}${c.url}`).join('\n');
          return text(sources ? `${reply.answer}\n\nSources:\n${sources}` : reply.answer);
        } catch (e) {
          return text(`The assistant did not answer: ${e instanceof Error ? e.message : String(e)}`, true);
        }
      },
    });
  }
</script>
